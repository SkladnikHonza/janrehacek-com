{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/nabidka/havirov-jarosova",
      "destination": "/nabidka/pronajem/havirov-jarosova",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://housio-crm-admin.vercel.app/"
    },
    {
      "source": "/admin/:match*",
      "destination": "https://housio-crm-admin.vercel.app/:match*"
    },
    {
      "source": "/google95dfeb17934d2c89.html",
      "destination": "/google95dfeb17934d2c89"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
